{
  "name": "retrokit",
  "version": "0.1.0",
  "description": "Unified, headless WebAssembly emulation runtime supporting Libretro (EmulatorJS & web.libretro.com), Play! PS2, and Adobe Flash (Ruffle).",
  "type": "module",
  "main": "./dist/retrokit.umd.cjs",
  "module": "./dist/retrokit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/retrokit.js",
      "require": "./dist/retrokit.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "emulator",
    "webassembly",
    "wasm",
    "libretro",
    "retroarch",
    "emulatorjs",
    "headless",
    "ps2",
    "play",
    "ruffle",
    "flash",
    "pico8"
  ],
  "author": "JellyfinPG",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3"
  }
}
